# Collabsta — copy to .env and set secrets locally (never commit .env)

APP_ENV=development
APP_DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database (adjust user/password/db for your environment)
DATABASE_URL=postgresql+asyncpg://collabsta:collabsta@localhost:5432/collabsta

# Redis (caching, job queues — wiring TBD)
REDIS_URL=redis://localhost:6379/0

# Auth / crypto — generate e.g. openssl rand -hex 32
SECRET_KEY=change-me

# File storage (local path or cloud bucket URL — TBD)
STORAGE_PATH=./data/uploads
